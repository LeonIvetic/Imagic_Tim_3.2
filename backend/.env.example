# Kopirajte u .env (cp .env.example .env). Datoteka .env se NE commita (to sam dodao u .gitignore).

# Adresa frontenda (CORS).
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://imagic:imagic@localhost:5433/imagic

AUTH0_DOMAIN=
AUTH0_AUDIENCE=

